class Solution:
    def reverse(self, x: int) -> int:
        if x<0:
            sign =-1
        else:
            sign=1
        revnum=0
        x=abs(x)

        while x > 0:
            ld = x%10

            revnum = revnum*10 + ld

            x=x//10
        
        ans=sign*revnum

        if ans< -2**31 or ans > 2**31 -1 :
            return 0
        else:
            return ans
        
